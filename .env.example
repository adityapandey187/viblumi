# Copy this file to .env for local development (never commit .env!)

# --- Model provider (swap these 3 to change AI providers) ---
# Groq (free tier, very fast) - create a free key at https://console.groq.com/keys
VIBLUMI_LLM_BASE_URL=https://api.groq.com/openai/v1
VIBLUMI_LLM_API_KEY=paste-your-groq-api-key-here
VIBLUMI_LLM_MODEL=openai/gpt-oss-120b
